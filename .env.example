# Copy to .env, fill in your endpoint and credentials, then export the values.
# Runners use environment variables; they do not automatically load this file.
OPENAI_API_KEY=YOUR_API_KEY
OPENAI_BASE_URL=https://your-openai-compatible-endpoint.example.com/v1

# Optional independent judge endpoint/key; defaults to OPENAI_* above.
# The Gemini agent profile uses Chat Completions for judging; other profiles
# use Responses. Configure an endpoint that serves the documented judge model.
# JUDGE_API_KEY=YOUR_JUDGE_API_KEY
# JUDGE_BASE_URL=https://your-judge-endpoint.example.com/v1

# Optional CLI binaries (otherwise resolved from PATH).
# OPENCLAW_BIN=openclaw
# CODEX_BIN=codex

# Optional explicit public config templates; relative to your working directory.
# RH_OPENCLAW_CONFIG=configs/openclaw.json
# RH_CODEX_CONFIG=configs/codex.toml
# RH_DATASET_DIR=dataset

# Optional original AgentDoG/ClawGuard integration components, supplied locally.
# RH_EXTERNAL_HELPER=external/manual_runner_agentdog_clawguard.py
# AGENTDOG_SERVICE_DIR="external/AgentDoG/Online Agentic Guardrail"
# AGENTDOG_GUARDRAIL_URL=http://127.0.0.1:8340
# CLAWGUARD_DIR=external/ClawGuard

# Optional original LlamaFirewall components, supplied locally.
# Scanner credentials continue to use OPENAI_API_KEY and OPENAI_BASE_URL.
# RH_LLAMAFIREWALL_SERVICE_V5=external/resource_hijack_llamafirewall_service_v5.py
# RH_LLAMAFIREWALL_V5_RUNNER=external/resource_hijack_runner_parent_contract_llamafirewall_v5.py
# RH_LLAMAFIREWALL_ROOT=external/PurpleLlama/LlamaFirewall
# RH_LLAMAFIREWALL_PLUGIN_V5=defenses/llamafirewall-v5/openclaw-plugin

# ResourceGuard: edit stage1_llm.base_url in defenses/config/guard_config.yaml.
# Its nonempty YAML endpoint takes precedence over OPENAI_BASE_URL.
